# Salin menjadi .env lalu isi. Jangan commit/bagikan file .env.

# Wajib diisi agar sesi login tetap berlaku setelah server restart. Buat dengan:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
# Tambahkan IP/domain yang dipakai mengakses, contoh dengan tunnel: localhost,127.0.0.1,cam.contoh.com
DJANGO_ALLOWED_HOSTS=

# Gunakan sub-stream (resolusi rendah) dari kamera
RTSP_URL=rtsp://admin:tesTing123456@192.168.1.18:554/12

# Token untuk aplikasi Android (header Authorization: Bearer). Buat panjang dan acak:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
STREAM_TOKEN=

# Kata sandi halaman login di browser (opsional; jika kosong memakai STREAM_TOKEN).
# Pakai kalimat sandi panjang (min. 12 karakter), berbeda dari token.
WEB_PASSWORD=ganti-dengan-kata-sandi-panjang

# --- Mode tunnel (akses dari luar jaringan) ---
# Aktifkan saat server berada di belakang Cloudflare Tunnel / ngrok / Tailscale Funnel.
TRUST_PROXY=false
# Alamat publik HTTPS dari tunnel, pisahkan koma jika lebih dari satu.
CSRF_TRUSTED_ORIGINS=
# Cookie hanya lewat HTTPS. Default mengikuti TRUST_PROXY; set false untuk uji lewat http:// biasa.
COOKIE_SECURE=false
# Lama sesi login (hari)
AUTH_SESSION_DAYS=7
# Batas percobaan gagal per IP, lalu dikunci
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
# Setelah HTTPS berjalan baik, boleh diisi 31536000
SECURE_HSTS_SECONDS=0

# --- Kinerja ---
JPEG_QUALITY=75
MAX_FPS=15
FRAME_WIDTH=960
IDLE_TIMEOUT=30
